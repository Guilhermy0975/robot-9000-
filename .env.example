# ===== Obrigatório (Módulo 2) =====
# Banco PostgreSQL. Na Vercel, crie em Storage → Neon e ela preenche sozinha.
DATABASE_URL=

# ===== Opcional =====
# Segredo da sessão. Se vazio, é derivado da DATABASE_URL.
AUTH_SECRET=

# Quantas respostas de IA cada pessoa pode gerar por dia (padrão 30)
DAILY_LIMIT=30

# ===== Provedores de IA (sem chave = resposta simulada) =====
# As chaves ficam só no servidor e nunca vão para o navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-flash-latest
# Nano Banana (imagens) usa a mesma GOOGLE_API_KEY. Outras opções:
# gemini-3.1-flash-lite-image (mais barato) ou gemini-3-pro-image (Pro)
NANO_BANANA_MODEL=gemini-3.1-flash-image

# Groq (API compatível com OpenAI). Os modelos Llama viraram Enterprise;
# o padrão é o GPT-OSS, liberado no plano gratuito.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
