# Tudo aqui é OPCIONAL. Sem chaves, o Robot 9000 usa respostas simuladas.
# As chaves ficam só no servidor e nunca vão para o navegador.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Llama via Groq (API compatível com OpenAI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
