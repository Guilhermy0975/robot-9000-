generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  folders       Folder[]
  usage         Usage[]
  keys          ProviderKey[]
  prompts       Prompt[]
  images        GeneratedImage[]
}

model Folder {
  id     String @id
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// As mensagens ficam em "turns" (JSON), no mesmo formato usado pela interface
model Conversation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  favorite  Boolean  @default(false)
  folderId  String?
  turns     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId, updatedAt])
}

// Quantas respostas de IA cada usuário gerou em cada dia (para o limite diário)
model Usage {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  count  Int    @default(0)

  @@id([userId, day])
}

// Chave de IA de cada usuário (criptografada) + configurações do modelo
model ProviderKey {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "gpt" | "claude" | "gemini" | "llama" (o Nano Banana usa a do "gemini")
  keyEnc      String
  keyHint     String
  model       String   @default("")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(1024)
  system      String   @default("")
  updatedAt   DateTime @updatedAt

  @@id([userId, provider])
}

// Biblioteca de prompts de cada usuário
model Prompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("Geral")
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// Imagens geradas (Nano Banana). A conversa guarda só o id; os bytes ficam aqui.
model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}
